# NextAuth
AUTH_SECRET=""  # Generate with: openssl rand -base64 32
NEXTAUTH_URL=""

# Comma-separated emails allowed to sign in (required in production)
ALLOWED_EMAILS=""

# Google OAuth (https://console.cloud.google.com)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Neon PostgreSQL (https://neon.tech)
DATABASE_URL=""  # Format: postgresql://user:pass@host/dbname?sslmode=require

# Basiq API (https://dashboard.basiq.io)
BASIQ_API_KEY=
BASIQ_WEBHOOK_SECRET=""  # Required in production; shown once when the webhook is registered
